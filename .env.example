# Copy to .env and fill in your own values. Never commit the real .env file.

# Browser (public, safe to expose)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server only (keep secret)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
LOVABLE_API_KEY=your-lovable-ai-gateway-key

# Optional: real SMS delivery (simulated when empty)
TWILIO_API_KEY=
TWILIO_FROM_NUMBER=
